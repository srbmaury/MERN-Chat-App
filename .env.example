PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mern-chat
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-long-random-secret
CLIENT_ORIGINS=http://localhost:3000
CLIENT_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

EMAIL_ID=
PASSWORD=
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=Talk-A-Tive
OTP_EXPIRATION_TIME_SECONDS=600

CLOUD_NAME=
API_KEY=
API_SECRET=
UPLOAD_PRESET=

UNSPLASH_ACCESS_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_ASSISTANT_NAME=Chat AI
AI_ASSISTANT_EMAIL=chat-ai@system.local
AI_ASSISTANT_PIC=https://cdn-icons-png.flaticon.com/512/4712/4712035.png
AI_ASSISTANT_INSTRUCTIONS=You are Chat AI, a helpful assistant inside a private chat application. Give accurate, practical, and concise answers in the language used by the user. Ask a clarifying question only when necessary. Clearly distinguish facts from assumptions, protect privacy, refuse harmful requests, and never claim capabilities you do not have.
AI_ASSISTANT_RATE_LIMIT_PER_MINUTE=10
AI_ASSISTANT_ALLOW_PROGRAMMING=false
